<idea-plugin>
    <!-- Never change after the first Marketplace upload. -->
    <id>dev.yendrrek.staginggroups</id>
    <name>Staging Groups</name>
    <vendor>yendrrek</vendor>

    <description><![CDATA[
        Named groups for changed files in the Git staging area and the Commit view.
        <br/><br/>
        Put changed files into staging groups such as "Feature A" or "Refactor": right-click them in
        the Commit view, the staging area, the Project view or an editor tab and choose
        <b>Staging Group</b>. Then choose <b>Group By | Staging Groups</b> to see each group as a
        node under <i>Staged</i> and <i>Unstaged</i>, and stage, unstage or roll back a whole group in
        one action.
        <br/><br/>
        Rename, recolour, reorder and delete staging groups in <b>Settings | Version Control | Staging
        Groups</b>, where colours can also be switched on.
    ]]></description>

    <resource-bundle>messages.StagingGroupsBundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends optional="true" config-file="staginggroups-git.xml">Git4Idea</depends>

    <extensionPoints>
        <extensionPoint name="vcsChangesView" interface="dev.yendrrek.staginggroups.vcs.VcsChangesView" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Errors users report from this plugin show on its Marketplace page. -->
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>

        <!-- Weight 50: above repository (30) and directory (10) grouping, so nearest the root. -->
        <changesGroupingPolicy key="staging-groups" id="staging-groups" weight="50"
                               implementationClass="dev.yendrrek.staginggroups.vcs.StagingGroupsGroupingPolicy$Factory"/>

        <!-- "first": a group's colour beats the IDE's File Colors scopes. "after prismtabs": PrismTabs
             colours tabs ahead of Staging Groups; the platform skips the constraint without it. -->
        <editorTabColorProvider id="staginggroups" order="first, after prismtabs"
                                implementation="dev.yendrrek.staginggroups.ui.StagingGroupColorProvider"/>

        <projectConfigurable parentId="project.propVCSSupport.Mappings" id="dev.yendrrek.staginggroups.settings" key="configurable.display.name"
                             nonDefaultProject="true" instance="dev.yendrrek.staginggroups.ui.StagingGroupsConfigurable"/>
    </extensions>

    <applicationListeners>
        <listener class="dev.yendrrek.staginggroups.lifecycle.DynamicUnloadListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="dev.yendrrek.staginggroups.vcs.ChangesViewRefresher"
                  topic="dev.yendrrek.staginggroups.state.StagingGroupsListener"/>
        <listener class="dev.yendrrek.staginggroups.ui.FileColourRefresher"
                  topic="dev.yendrrek.staginggroups.state.StagingGroupsListener"/>
    </projectListeners>

    <actions>
        <!-- ChangesView.GroupBy is shared by the Commit view and the staging area's options menu. -->
        <action id="StagingGroups.GroupBy" class="dev.yendrrek.staginggroups.vcs.ToggleStagingGroupsGroupingAction">
            <add-to-group group-id="ChangesView.GroupBy"/>
        </action>

        <action id="StagingGroups.NewGroup" class="dev.yendrrek.staginggroups.actions.NewStagingGroupAction"/>
        <action id="StagingGroups.Remove" class="dev.yendrrek.staginggroups.actions.RemoveFromStagingGroupAction"/>
        <action id="StagingGroups.Manage" class="dev.yendrrek.staginggroups.actions.ManageStagingGroupsAction"/>

        <group id="StagingGroups.Assign" popup="true" class="dev.yendrrek.staginggroups.actions.StagingGroupMenu">
            <group id="StagingGroups.Assign.Choices" class="dev.yendrrek.staginggroups.actions.StagingGroupChoices"/>
            <separator/>
            <reference ref="StagingGroups.NewGroup"/>
            <reference ref="StagingGroups.Remove"/>
            <separator/>
            <reference ref="StagingGroups.Manage"/>
            <add-to-group group-id="ChangesViewPopupMenu" anchor="after" relative-to-action="ChangesView.Move"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="VersionControlsGroup"/>
            <!-- Never anchor="first" here: that slot is PrismTabs'. -->
            <add-to-group group-id="EditorTabPopupMenu" anchor="after" relative-to-action="ReopenClosedTab"/>
        </group>
    </actions>
</idea-plugin>
